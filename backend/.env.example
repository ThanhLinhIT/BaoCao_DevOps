SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# ⚠️ SERVICE_ROLE_KEY: Lay tu Supabase > Settings > API > service_role (CHUA DIEN)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# URL frontend dung cho CORS (cap nhat sau khi deploy frontend len Vercel)
FRONTEND_URL=http://localhost:5173

PORT=3001

# --- Frontend (VITE_ prefix bat buoc) ---
VITE_SUPABASE_URL=your_vite_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_vite_supabase_anon_key_here
